    foreach(row RANGE 1 11)
        string(APPEND content "unlimited ${i} ${row}\n")
    endforeach()
    file(WRITE "${fixture}/many/${i}.txt" "${content}")
endforeach()
check_cli(unlimited "/index many\n/search unlimited\n/next\n/prev\n/more 0.txt\n/exit\n"
    0 "11: unlimited 11 11" start --no-tui)
foreach(unwanted " more" "score:" "Page ")
    string(FIND "${last_output}" "${unwanted}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "unlimited output contains ${unwanted}: ${last_output}")
    endif()
endforeach()
foreach(i RANGE 0 11)
    string(FIND "${last_output}" "[${i}.txt] 10+" found)
