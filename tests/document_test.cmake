execute_process(COMMAND "${TEST_APP}" "${FIXTURE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "document_test failed: ${output}${error}")
endif()

# Parse actual saved files independently of the C++ serializer.
file(READ "${FIXTURE}/output/documents.json" json)
string(JSON count LENGTH "${json}")
if(NOT count EQUAL 2)
    message(FATAL_ERROR "expected two serialized documents")
endif()
foreach(index 0 1)
    string(JSON fields LENGTH "${json}" ${index})
    string(JSON id GET "${json}" ${index} id)
    string(JSON token_count GET "${json}" ${index} tokenCount)
    string(JSON path GET "${json}" ${index} path)
    string(JSON title GET "${json}" ${index} title)
    if(NOT fields EQUAL 4 OR NOT id EQUAL index OR NOT token_count EQUAL 0)
        message(FATAL_ERROR "incorrect Document schema or values")
    endif()
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "Document path must reference the original file")
    endif()
    get_filename_component(filename "${path}" NAME)
    if(NOT title STREQUAL filename)
        message(FATAL_ERROR "Document title must match the filename")
    endif()
endforeach()
file(READ "${FIXTURE}/escaped.json" escaped)
string(JSON escaped_path GET "${escaped}" 0 path)
string(JSON title GET "${escaped}" 0 title)
if(NOT title STREQUAL "자료 구조")
    message(FATAL_ERROR "UTF-8 JSON round trip failed")
endif()
file(REMOVE_RECURSE "${FIXTURE}")
